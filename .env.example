# ============================================================
# AI Habit Quest — example environment. Copy to .env and fill.
# ============================================================

# --- Common ---
NODE_ENV=development
TZ=Europe/Moscow

# --- Postgres ---
POSTGRES_USER=ahq
POSTGRES_PASSWORD=ahq_dev_password_change_me
POSTGRES_DB=ai_habit_quest
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ahq:ahq_dev_password_change_me@postgres:5432/ai_habit_quest?schema=public

# --- Backend (NestJS) ---
BACKEND_PORT=3001
PUBLIC_API_URL=http://localhost:3001
JWT_SECRET=please_replace_with_long_random_string

# --- Telegram ---
# Get from @BotFather. Revoke any token that leaks.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
# Used to validate WebApp initData (HMAC). Same as TELEGRAM_BOT_TOKEN.
TELEGRAM_WEBAPP_BOT_TOKEN=

# --- AI service ---
AI_SERVICE_URL=http://ai-service:8000
AI_PROVIDER=stub          # stub | ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b     # or gemma3:4b

# --- Web (Vite, prefixed VITE_ to be exposed to client) ---
VITE_API_BASE_URL=http://localhost:3001
VITE_TG_BOT_USERNAME=

# --- Payments (filled later) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
TELEGRAM_STARS_ENABLED=false

# --- Admin ---
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASSWORD=please_replace_admin_password

# --- Free tier limits ---
FREE_MAX_GOALS=1
FREE_MAX_HABITS=3
FREE_PLAN_HORIZON_DAYS=7
