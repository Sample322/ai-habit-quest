// AI Habit Quest — Prisma schema
// Single source of truth for the relational model.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev (Windows / macOS), "debian-openssl-3.0.x"
  // covers the production runtime image (node:20-bookworm-slim).
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GoalCategory {
  sport
  study
  discipline
  custom
}

enum GoalStatus {
  active
  archived
}

enum SubscriptionProvider {
  yookassa
  telegram_stars
  manual
}

enum SubscriptionStatus {
  trial
  active
  past_due
  canceled
  expired
}

enum PaymentEventStatus {
  pending
  succeeded
  failed
  refunded
}

model User {
  id            String   @id @default(cuid())
  telegramId    BigInt   @unique
  username      String?
  firstName     String?
  lastName      String?
  languageCode  String   @default("ru")
  timezone      String   @default("Europe/Moscow")
  reminderHour  Int      @default(9)
  reminderMinute Int     @default(0)
  // U: per-channel notification preferences. All default-on so legacy users
  // keep current behaviour; UI lets them mute individual streams.
  notifReminders     Boolean @default(true)
  notifAchievements  Boolean @default(true)
  notifSeasons       Boolean @default(true)
  notifStreakBreak   Boolean @default(true)
  notifWeeklyRecap   Boolean @default(true)
  // T: weekly recap tracking — last Monday a recap DM was sent (avoid double).
  lastRecapAt        DateTime?
  isPremium     Boolean  @default(false)
  premiumUntil  DateTime?
  streakCurrent Int      @default(0)
  streakBest    Int      @default(0)
  // L: streak-break DM. Set when streak transitions positive → 0 in recompute.
  // Cleared when recompute sees current > 0 again.
  streakBrokenAt       DateTime?
  streakBrokenNotified Boolean   @default(false)
  xpTotal       Int      @default(0)
  level         Int      @default(0)
  // D1: streak freeze — Premium-only restore. Counter resets when month changes.
  // streakFreezeDates: ISO YYYY-MM-DD strings that recompute treats as "had a completion"
  streakFreezesLeft  Int      @default(2)
  streakFreezesMonth String?              // "YYYY-MM" in user's TZ
  streakFreezeDates  String[] @default([])
  // D5 / referral 2.0:
  // - referralRewarded: inviter has been paid +3d (one-shot, on invitee's first goal create)
  // - referralGiftClaimedAt: timestamp when invitee got their welcome +3d gift
  // - referralGiftReminderSent: bot DM sent once after gift expires
  referralRewarded         Boolean   @default(false)
  referralGiftClaimedAt    DateTime?
  referralGiftReminderSent Boolean   @default(false)
  referralCode  String   @unique
  referredById  String?
  referredBy    User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]   @relation("Referrals")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  goals         Goal[]
  habits        Habit[]
  dailyTasks    DailyTask[]
  bonusTasks    BonusTask[]
  badges        UserBadge[]
  subscriptions Subscription[]
  payments      PaymentEvent[]
  feedback      Feedback[]
  leagueMembers LeagueMember[]
  seasonResults SeasonResult[]

  @@index([referredById])
}

model Goal {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  category    GoalCategory
  status      GoalStatus   @default(active)
  horizonDays Int          @default(7)
  startedAt   DateTime     @default(now())
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  habits      Habit[]
  plan        Plan?

  @@index([userId, status])
}

model Habit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyTasks DailyTask[]

  @@index([goalId])
  @@index([userId])
}

model Plan {
  id          String   @id @default(cuid())
  goalId      String   @unique
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  horizonDays Int
  provider    String   // "stub" | "ollama"
  payload     Json     // full plan JSON returned by ai-service
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DailyTask {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId     String
  habit       Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  localDate   DateTime  @db.Date
  title       String
  doneAt      DateTime?
  xpAwarded   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([habitId, localDate])
  @@index([userId, localDate])
}

model BonusTask {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId    String
  localDate DateTime  @db.Date
  title     String
  xp        Int       @default(25)
  provider  String    // "openai" | "stub"
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, localDate])
  @@index([userId, localDate])
}

model Badge {
  id          String      @id @default(cuid())
  code        String      @unique
  title       String
  description String
  iconKey     String
  createdAt   DateTime    @default(now())

  userBadges  UserBadge[]
}

model UserBadge {
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge   @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@id([userId, badgeId])
}

model Subscription {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          SubscriptionProvider
  status            SubscriptionStatus
  paymentMethodId   String?              // YooKassa saved card token
  externalId        String?              // YooKassa subscription/payment id
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  payments          PaymentEvent[]

  @@index([userId, status])
}

model PaymentEvent {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  provider       SubscriptionProvider
  externalId     String?
  amountMinor    Int                 // in minor units (kopeks or stars)
  currency       String              // "RUB" | "XTR"
  status         PaymentEventStatus
  rawPayload     Json?
  createdAt      DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([externalId])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  message   String
  createdAt DateTime @default(now())
}

// D2: leagues. Weekly groups of ~30 users; XP this week ranks them inside the
// league. Cron rotates: top 7 promote up a tier, bottom 5 demote, mid stays.
model League {
  id          String         @id @default(cuid())
  tier        Int            // 0 = Bronze, 1 = Silver, ... up to 4 = Diamond
  weekStart   DateTime       @db.Date  // Monday of the week this league covers
  createdAt   DateTime       @default(now())
  members     LeagueMember[]

  @@index([weekStart, tier])
}

model LeagueMember {
  id          String   @id @default(cuid())
  leagueId    String
  league      League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyXp    Int      @default(0)
  joinedAt    DateTime @default(now())

  @@unique([leagueId, userId])
  @@index([userId])
  @@index([leagueId, weeklyXp])
}

// D: seasons. 4-week XP races. Snapshot top-N at close, reward, start new.
enum SeasonStatus {
  active
  closed
}

model Season {
  id        String        @id @default(cuid())
  number    Int           @unique          // 1, 2, 3 …
  startDate DateTime      @db.Date
  endDate   DateTime      @db.Date
  status    SeasonStatus  @default(active)
  createdAt DateTime      @default(now())

  results   SeasonResult[]

  @@index([status])
}

model SeasonResult {
  id            String   @id @default(cuid())
  seasonId      String
  season        Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonalXp    Int      @default(0)
  finalRank     Int                // 1-based; assigned at close
  rewardClaimed Boolean  @default(false)
  rewardKind    String?            // "premium_7d" | "premium_3d" | "badge"
  createdAt     DateTime @default(now())

  @@unique([seasonId, userId])
  @@index([userId])
  @@index([seasonId, finalRank])
}

model PlanCache {
  id          String   @id @default(cuid())
  cacheKey    String   @unique // hash of category|level|horizonDays|provider
  category    GoalCategory
  horizonDays Int
  provider    String
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
